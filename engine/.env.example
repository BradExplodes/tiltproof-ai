OPENAI_API_KEY=your_openai_api_key_here
# --- Backend proxy (optional) ---
# When set, the engine routes all OpenAI calls through the backend proxy and sends
# AICOACH_PROXY_TOKEN as the credential (the real OpenAI key stays on the server).
# Left blank for local/direct mode. The desktop app sets these at launch.
# AICOACH_OPENAI_BASE_URL=https://your-worker.example.workers.dev/openai/v1
# AICOACH_PROXY_TOKEN=
# gpt-4o-mini = cheaper | gpt-4o = better screen/UI reasoning (recommended)
OPENAI_MODEL=gpt-4o-mini
# Vision describe pass (defaults to OPENAI_MODEL); gpt-4o recommended for reading HUD text
OPENAI_DESCRIBE_MODEL=gpt-4o-mini
CAPTURE_INTERVAL_SECONDS=20
SAVE_SCREENSHOTS=false
# high = better HUD/UI read (~12–20s) | low = faster (~4–8s), less accurate
IMAGE_DETAIL=high
# Voice HUD/map text: Tesseract OCR (default). Idle/20s cycles still use vision.
OCR_ENABLED=true
OCR_ENGINE=tesseract
OCR_LANGUAGE=en
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Game HUD OCR: CLAHE + inverted threshold (light text on dark UI). See tessdoc ImproveQuality.
OCR_SCALE_FACTOR=2
OCR_PREPROCESS_MODE=game
OCR_MULTI_PSM=true
OCR_MAX_WIDTH=1600
OCR_VOICE_FAST=true
# Save timestamped capture to screenshots/ on each OCR run (ocr_read_*.png, ocr_probe_*.png)
OCR_SAVE_SCREENSHOTS=true
# Native monitor resolution PNG for OCR/voice (not CAPTURE_MAX_WIDTH JPEG)
OCR_CAPTURE_FULL_QUALITY=true
# Also save ocr_debug_last.png (best preprocess pass fed to Tesseract)
OCR_DEBUG_SAVE=false
OCR_TESSERACT_CONFIG=--oem 3 --psm 6
# Screenshots for vision and voice OCR (full 4K PNG is not used — too slow for Tesseract)
CAPTURE_MAX_WIDTH=1280
# JPEG quality 1–95 for vision; 0 = PNG
CAPTURE_JPEG_QUALITY=82
# Cap vision output length (default 450); lower = slightly faster, less HUD detail in text
DESCRIBE_MAX_TOKENS=450
TTS_ENABLED=true
# elevenlabs (default) | openai
TTS_PROVIDER=elevenlabs
# ElevenLabs — sign in via the desktop app (proxy) or set ELEVENLABS_API_KEY for local dev
# AICOACH_ELEVENLABS_BASE_URL=https://api.tiltproof.net/elevenlabs/v1
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# OpenAI TTS fallback (TTS_PROVIDER=openai)
TTS_MODEL=tts-1
TTS_VOICE=ash
POST_SPEECH_DELAY_SECONDS=8
# Ignore barge-in for this long after TTS starts (reduces speaker-bleed false stops)
TTS_BARGE_GRACE_SECONDS=1.25
# Prior spoken lines recalled (not old screenshots) — helps avoid "nothing new" silence
MAX_HISTORY_MESSAGES=12
COACH_TEMPERATURE=0.65
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODEL=gpt-4o-mini
# high recommended for osu map section research
WEB_SEARCH_CONTEXT_SIZE=high
WEB_SEARCH_SCENES=map_select,menu,results

# Voice input (always-on mic, RMS volume gate — not push-to-talk)
VOICE_INPUT_ENABLED=true
# Min loudness 0–1; raise if phantom speech / echo still triggers (try 0.035–0.045)
VOICE_MIN_RMS=0.028
# End-of-speech silence before sending utterance (1500 = 1.5s; try 2000 if still splits)
VOICE_SILENCE_MS=1500
VOICE_MIN_SPEECH_MS=350
# Stop coach TTS after this much user speech (ms) during playback — 1000–2000 typical
VOICE_BARGE_SPEECH_MS=1500
VOICE_MAX_UTTERANCE_SECONDS=25
VOICE_STT_MODEL=whisper-1
